.entdec-conditions__rule data-entdec--conditions-target="rule" data-kind=kind data-action="entdec--variable-picker:change->entdec--conditions#chosen"
  - if variables_url
    = render EntDec::VariablePicker::Component.new(name: name(:variable), value: rule.variable, label: label, url: variables_url)
  - else
    = text_field_tag name(:variable), rule.variable, id: nil, class: "entdec-pill-input entdec-pill-input--wide", placeholder: "user.name", aria: {label: t("entdec.variable_picker.label")}
  .entdec-conditions__operator
    = render EntDec::PillSelect::Component.new(name: name(:operator), label: t("entdec.conditions.operator"), options: operator_options, selected: rule.operator, tone: :operator, select_html: {"data-entdec--conditions-target" => "operator", "data-action" => "change->entdec--conditions#update"})
  span.entdec-conditions__value data-role="text"
    = text_field_tag name(:value), rule.value, id: nil, class: "entdec-pill-input entdec-pill-input--medium", aria: {label: t("entdec.conditions.value")}
  span.entdec-conditions__value data-role="boolean"
    = render EntDec::PillSelect::Component.new(name: name(:value), label: t("entdec.conditions.value"), options: boolean_options, selected: (rule.value.presence || "true"))
  span.entdec-conditions__value data-role="between"
    span = t("entdec.conditions.and")
    = text_field_tag name(:value_to), rule.value_to, id: nil, class: "entdec-pill-input entdec-pill-input--medium", aria: {label: t("entdec.conditions.value_to")}
  button.entdec-conditions__remove type="button" data-action="entdec--conditions#remove" aria-label=t("entdec.conditions.remove") title=t("entdec.conditions.remove")
    svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
      path d="M3.5 8h9"
